{
  "manifest_version": 3,
  "name": "自定义新标签页 - 书签管理器",
  "version": "1.1.0",
  "description": "一个简洁优雅的Chrome新标签页，支持书签管理、访问频次排序和 WebDAV 云同步。",
  "permissions": ["storage", "activeTab", "favicon", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/tab.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/tab.png",
    "32": "icons/tab.png",
    "48": "icons/tab.png",
    "128": "icons/tab.png"
  }
}
